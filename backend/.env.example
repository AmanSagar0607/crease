# Create a GitHub OAuth app; never commit the resulting .env file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
COOKIE_SECURE=false
# Register a GitHub App separately from the sign-in OAuth App.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_APP_TOKEN_KEY=
# Set once after deploying Crease; must be a public HTTPS origin.
CREASE_PUBLIC_ORIGIN=
