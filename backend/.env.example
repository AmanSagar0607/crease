# Configure Clerk for account authentication; keep secrets out of source control. GitHub is optional repository integration.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-production-domain.example
CLERK_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
COOKIE_SECURE=false
# Register a GitHub App separately from the sign-in OAuth App.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_APP_TOKEN_KEY=
# Set once after deploying Zappa; must be a public HTTPS origin.
CREASE_PUBLIC_ORIGIN=
# Optional Vercel connectable-account integration for per-user Git settings.
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# Use a separate Fernet key; do not reuse or publish it.
VERCEL_TOKEN_KEY=

# Path to a locally installed MaxMind GeoLite2 Country .mmdb database.
GEOIP_DATABASE_PATH=./GeoLite2-Country.mmdb
# Optional: keep the local database updated automatically (requires a MaxMind account).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_UPDATE_INTERVAL_DAYS=7
# Same server-only random secret on Render and Vercel. Protects client-IP forwarding.
GEO_FORWARD_SECRET=
# Optional external trigger for POST /internal/retention. The API also deletes expired
# events on its own schedule, so no cron service is required.
RETENTION_SECRET=
# Hours between automatic retention passes. Set 0 to disable the in-process scheduler.
RETENTION_INTERVAL_HOURS=24
# Wait this long after startup before the first pass.
RETENTION_START_DELAY_SECONDS=30
# Drop crawler, monitor, and automation traffic at ingest. Set false only for debugging.
FILTER_BOTS=true
# Separate Fernet key for encrypted payment webhook credentials.
PAYMENT_ENCRYPTION_KEY=
