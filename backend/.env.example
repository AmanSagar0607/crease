# Create a GitHub OAuth app; never commit the resulting .env file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
COOKIE_SECURE=false
# Register a GitHub App separately from the sign-in OAuth App.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_APP_TOKEN_KEY=
# Set once after deploying Crease; must be a public HTTPS origin.
CREASE_PUBLIC_ORIGIN=
# Optional Vercel connectable-account integration for per-user Git settings.
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# Use a separate Fernet key; do not reuse or publish it.
VERCEL_TOKEN_KEY=

# Forwarded country is trusted on the secret-authenticated internal route. Set false
# only when an untrusted party can hold GEO_FORWARD_SECRET.
TRUST_VERCEL_GEO=true
# Same server-only random secret on Render and Vercel. Required for country data.
GEO_FORWARD_SECRET=
# Optional external trigger for POST /internal/retention. The API also deletes expired
# events on its own schedule, so no cron service is required.
RETENTION_SECRET=
# Hours between automatic retention passes. Set 0 to disable the in-process scheduler.
RETENTION_INTERVAL_HOURS=24
# Wait this long after startup before the first pass.
RETENTION_START_DELAY_SECONDS=30
# Drop crawler, monitor, and automation traffic at ingest. Set false only for debugging.
FILTER_BOTS=true
